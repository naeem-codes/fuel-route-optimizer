# Export these variables in your environment; .env files are not loaded automatically.
# Required outside development. Never commit a real secret.
SECRET_KEY=
# Accepts true/false or 1/0. DEBUG=false requires SECRET_KEY.
DEBUG=true
# Comma-separated hostnames, without schemes or ports.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
OPENROUTESERVICE_API_KEY=
# Provider-result cache lifetime in seconds; 0 disables storage. Default: 24 hours.
ROUTING_CACHE_TTL_SECONDS=86400
